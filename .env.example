# Copy this file to .env (never commit .env) and fill in the values.
# docker compose reads .env automatically. Leave SMTP_HOST empty to write
# emails to outbox.log in the data folder instead of sending them.

# Resend: host smtp.resend.com, port 587, user "resend", password = your Resend API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must use the domain verified in Resend, e.g. no-reply@mail.yourdomain.com
MAIL_FROM="Transcript Service <no-reply@mail.example.com>"

# Exact address people use to open the site, without a trailing slash,
# e.g. https://transcripts.example.com. Verification links are built from it.
PUBLIC_ORIGIN=
